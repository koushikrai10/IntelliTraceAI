# ================================================
# IntelliTrace AI - Environment Configuration
# ================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ================================================

# --- Active Storage Profile ---
# Options:
#   'dev'      : In-memory H2 database (default, fast for testing, resets on restart)
#   'h2-file'  : Persistent file-based H2 database (saves to ./data/ folder, zero-install)
#   'mysql'    : Production MySQL database (requires running MySQL server)
SPRING_PROFILES_ACTIVE=dev

# --- MySQL Configuration (Used when SPRING_PROFILES_ACTIVE=mysql) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=intellitracedb
MYSQL_USERNAME=your_mysql_username
MYSQL_PASSWORD=your_mysql_password

# Optional: Alternative single JDBC connection string (overrides individual MYSQL_* settings if provided)
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/intellitracedb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# --- AI API Configuration (Google Gemini) ---
# Google Gemini API key (optional - platform operates seamlessly with heuristic fallback if omitted).
# Obtain a key from Google AI Studio: https://aistudio.google.com/
# NEVER commit your real API key into source control!
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# --- Application Configuration ---
# Maximum file upload size in bytes (default: 50MB = 52428800)
MAX_FILE_SIZE=52428800

# Server port (default: 8080)
SERVER_PORT=8080
